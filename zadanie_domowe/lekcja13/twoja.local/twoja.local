  GNU nano 8.7.1                                /etc/nginx/sites-available/twoja.local
server {
    listen 80;
    server_name twoja.local;

    root /home/mlakio/lekcja-13/zd13/twoja.local;
    index index.html index.htm;

    error_page 404 /errors/404.html;
    error_page 500 502 503 504 /errors/50x.html;

    location = /errors/404.html {
        internal;
    }

    location = /errors/50x.html {
        internal;
    }
}
